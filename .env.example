# Opt-in semantic anti-fraud / second-opinion layer (pipeline/embeddings.py).
# Leave unset to run the app fully local (uses the average-hash duplicate check instead).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional tuning:
# ECO_EMBED_MODEL=gemini-embedding-2-preview
# ECO_REPLAY_THRESHOLD=0.90          # cosine ceiling for "same event resubmitted"
# ECO_SECOND_OPINION_MARGIN=0.03     # how decisively the wrong cluster must win to flag
